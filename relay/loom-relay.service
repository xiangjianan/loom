[Unit]
Description=Loom model API relay
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=loom-relay
Group=loom-relay
WorkingDirectory=/opt/loom-relay
ExecStart=/usr/local/bin/node /opt/loom-relay/server.mjs
Environment=PORT=8791
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
